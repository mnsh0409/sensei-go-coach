# Copy to .env and fill in. .env is gitignored; never commit it.

# Meta Model API
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# KataGo: absolute paths, unquoted or with forward slashes, e.g. C:/katago/katago.exe
# Never wrap Windows paths in double quotes: python-dotenv turns \n, \b and similar into control characters.
KATAGO_EXE=
KATAGO_MODEL=
KATAGO_HUMAN_MODEL=
KATAGO_CONFIG=
# Label of the KataGo build for result files and the poster's scaling figure: cuda, trt, opencl or eigen
KATAGO_BACKEND=cuda
